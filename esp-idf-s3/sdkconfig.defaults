#
# HardID ESP32-S3 sdkconfig defaults
# Target board: Waveshare ESP32-S3-Touch-LCD-2 (ESP32-S3R8)
# Apply: idf.py set-target esp32s3
#

# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash / PSRAM (S3R8 module: 16MB flash, 8MB Octal PSRAM)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM (Clear Sign needs RAM for large PSBT / EVM ABI / QR frames)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Security: flash encryption + secure boot v2 (enable in production)
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
# CONFIG_SECURE_BOOT_V2_ENABLED=y

# Optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Log
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Console: Waveshare ESP32-S3-Touch-LCD-2 has no USB-UART bridge / no UART0
# exposed; the board exposes native USB only.
#
# IMPORTANT: GPIO19/20 is shared between USB-Serial-JTAG (USJ) and USB-OTG.
# The OTG composite (CTAPHID HID + CDC-ACM) can only enumerate if the USJ
# peripheral is fully disabled — the boot clock init only drops the USJ pad
# when BOTH USJ_ENABLE_USB_SERIAL_JTAG=n AND the console is not on USJ.
# Leaving the console on USJ keeps the pad driving GPIO19/20, so the host
# never sees the composite (it keeps enumerating the ROM JTAG unit).
#
# So: no boot console; the app redirects stdout to the composite CDC at
# runtime (usb_esp.c -> tinyusb_console_init) once the OTG is up.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# TinyUSB composite for FIDO (HID) + linkproto (CDC-ACM)
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
